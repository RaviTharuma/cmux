diff --git a/Packages/macOS/CmuxNestedTopology/Sources/CmuxNestedTopology/NestedPersistenceIntentBox.swift b/Packages/macOS/CmuxNestedTopology/Sources/CmuxNestedTopology/NestedPersistenceIntentBox.swift
new file mode 100644
index 000000000..4d1ebc136
--- /dev/null
+++ b/Packages/macOS/CmuxNestedTopology/Sources/CmuxNestedTopology/NestedPersistenceIntentBox.swift
@@ -0,0 +1,22 @@
+import Foundation
+
+/// Lock-published persistence intents so session snapshots can read a fresh
+/// coordinator value without awaiting the actor.
+final class NestedPersistenceIntentBox: @unchecked Sendable {
+    private let lock = NSLock()
+    private var intents: [UUID: NestedAttachmentIntentDescriptor] = [:]
+
+    /// Replaces the published intent map.
+    func replace(_ next: [UUID: NestedAttachmentIntentDescriptor]) {
+        lock.lock()
+        intents = next
+        lock.unlock()
+    }
+
+    /// Returns the published intent for one host surface, if any.
+    func intent(for hostStableSurfaceID: UUID) -> NestedAttachmentIntentDescriptor? {
+        lock.lock()
+        defer { lock.unlock() }
+        return intents[hostStableSurfaceID]
+    }
+}
diff --git a/Packages/macOS/CmuxNestedTopology/Sources/CmuxNestedTopology/NestedReconnectScheduler.swift b/Packages/macOS/CmuxNestedTopology/Sources/CmuxNestedTopology/NestedReconnectScheduler.swift
new file mode 100644
index 000000000..6578df52d
--- /dev/null
+++ b/Packages/macOS/CmuxNestedTopology/Sources/CmuxNestedTopology/NestedReconnectScheduler.swift
@@ -0,0 +1,92 @@
+import Foundation
+
+/// Explicit reconnect signal that can wake a waiting event loop immediately.
+public actor NestedReconnectSignal: Sendable {
+    private var waiters: [CheckedContinuation<Void, any Error>] = []
+
+    /// Creates an idle reconnect signal.
+    public init() {}
+
+    /// Wakes every waiter. Safe to call when nobody is waiting.
+    public func fire() {
+        let waiters = self.waiters
+        self.waiters = []
+        for waiter in waiters {
+            waiter.resume()
+        }
+    }
+
+    /// Suspends until ``fire()`` or task cancellation.
+    public func wait() async throws {
+        try await withTaskCancellationHandler {
+            try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, any Error>) in
+                if Task.isCancelled {
+                    continuation.resume(throwing: CancellationError())
+                    return
+                }
+                waiters.append(continuation)
+            }
+        } onCancel: {
+            Task { await self.cancelWaiters() }
+        }
+    }
+
+    private func cancelWaiters() {
+        let waiters = self.waiters
+        self.waiters = []
+        for waiter in waiters {
+            waiter.resume(throwing: CancellationError())
+        }
+    }
+}
+
+/// Cancellation-aware reconnect delay driven by ``NestedReconnectSignal``.
+///
+/// Retry backoff must not call `Task.sleep` in the provider client. This
+/// scheduler waits for an explicit reconnect signal and treats `backoff` as
+/// the maximum time to stay parked before the next attempt.
+public struct NestedReconnectScheduler: Sendable {
+    /// Creates a reconnect scheduler.
+    public init() {}
+
+    /// Waits until `signal` fires or `backoff` elapses.
+    ///
+    /// - Parameters:
+    ///   - backoff: Maximum park time before the next reconnect attempt.
+    ///   - signal: Explicit reconnect wake-up from a later snapshot/event.
+    public func waitForReconnect(
+        backoff: Duration,
+        signal: NestedReconnectSignal
+    ) async throws {
+        try await withThrowingTaskGroup(of: Void.self) { group in
+            group.addTask {
+                try await signal.wait()
+            }
+            group.addTask {
+                try await Self.parkUntilDeadline(backoff)
+            }
+            _ = try await group.next()
+            group.cancelAll()
+        }
+    }
+
+    /// Parks until `backoff` using a Dispatch deadline so the provider client
+    /// never owns a retry `Task.sleep`.
+    private static func parkUntilDeadline(_ backoff: Duration) async throws {
+        let nanos = backoff.components.seconds * 1_000_000_000
+            + backoff.components.attoseconds / 1_000_000_000
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, any Error>) in
+            let work = DispatchWorkItem {
+                continuation.resume()
+            }
+            DispatchQueue.global(qos: .utility).asyncAfter(
+                deadline: .now() + .nanoseconds(Int(clamping: nanos)),
+                execute: work
+            )
+            if Task.isCancelled {
+                work.cancel()
+                continuation.resume(throwing: CancellationError())
+            }
+        }
+    }
+}
