diff --git a/Packages/macOS/CmuxNestedTopology/Sources/CmuxNestedTopology/NestedPersistenceIntentBox.swift b/Packages/macOS/CmuxNestedTopology/Sources/CmuxNestedTopology/NestedPersistenceIntentBox.swift
